# Required: MongoDB Atlas connection string (use a read-only database user for the web app)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/main
MONGODB_DB=main

# Required: Mapbox public token (pk.*) from https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: Redis cache (e.g. an Upstash rediss:// URL). Caching is skipped if unset.
REDIS_URL=

# Optional: URL of the separately hosted Python RAG server (OceanWatch3/server).
# Leave unset to show the chat assistant as offline.
NEXT_PUBLIC_RAG_SERVER_URL=
